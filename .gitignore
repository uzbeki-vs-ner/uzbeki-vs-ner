# Python / uv
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Runtime outputs — keep only the placeholder
/outputs/*
!/outputs/.gitkeep

# IDE / tooling (commit shared Cursor rules, ignore the rest)
.vscode/
.idea/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.opencode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data & model artifacts (DVC tracks blobs; git keeps only pointers + docs)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Official organizer dumps — never GitHub
data/official/bundle/
data/official/archive/
data/official/*.jsonl
data/official/*.zip
data/official/*
!data/official/README.md
!data/official/.gitkeep

data/processed/*
!data/processed/.gitkeep

# External datasets (HF / Zenodo / etc.) — never GitHub
data/external/**
!data/external/CATALOG.md
!data/external/.gitkeep

ner_uz_hackathon_participant*.zip
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

/checkpoints/*
!/checkpoints/.gitkeep

# Weights / exports / pretrained dumps
models/pretrained/**
models/**
!models/.gitkeep
*.pt
*.pth
*.bin
*.ckpt
*.onnx
*.safetensors
*.h5
*.gguf
*.npz

# MLflow (local sqlite + artifact store)
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# Hugging Face / transformers / datasets caches (never commit downloads)
.cache/
**/.cache/
.huggingface/
huggingface_hub/
hf_cache/
.hf/
transformers_cache/
.transformers_cache/

# DVC cache (never commit). dvc.yaml / dvc.lock ARE source and may be committed.
.dvc/cache/
.dvc/tmp/

# Logs & caches
*.log
.pytest_cache/
.ipynb_checkpoints/
*.ipynb
.runs/
wandb/
lightning_logs/

# Hydra
multirun/
.hydra/

# Docker / runtime
.docker/
