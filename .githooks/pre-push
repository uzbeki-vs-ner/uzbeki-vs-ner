#!/bin/bash
# Block push to corporate / internal remotes (personal GitHub only).
set -euo pipefail

remote="${1:-origin}"

blocked_re='(?i)(ptsecurity|positive\.tech|gitlab\.|git\.pt|\.internal[./]|corp\.|corporate\.|stash\.|bitbucket\.pt)'

check_url() {
  local url="$1"
  local label="$2"
  if [ -z "$url" ]; then
    return 0
  fi
  if echo "$url" | grep -Eq "$blocked_re"; then
    echo "pre-push: blocked $label URL looks corporate/internal:" >&2
    echo "  $url" >&2
    echo "Use GitHub only, e.g. git@github.com:bugkira/ITMO_hack.git" >&2
    exit 1
  fi
}

remote_url="$(git remote get-url "$remote" 2>/dev/null || true)"
push_url="$(git config --get "remote.${remote}.pushurl" 2>/dev/null || true)"

check_url "$remote_url" "remote.$remote.url"
check_url "$push_url" "remote.$remote.pushurl"

exit 0
