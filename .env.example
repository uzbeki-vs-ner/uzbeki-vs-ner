# Hugging Face (скачивание моделей)
HF_TOKEN=

# CUDA (пусто = auto)
# CUDA_VISIBLE_DEVICES=0

# MLflow — единый backend для экспериментов
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=uzbek_ner
MLFLOW_SMOKE_EXPERIMENT=uzbek_ner_smoke

# Local eval dashboard registry (JSON files scraped by the CPU eval API)
# EVAL_RUNS_DIR=outputs/eval/runs

# DVC — remote для датасетов (настроить после `dvc remote add`)
# DVC_REMOTE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
